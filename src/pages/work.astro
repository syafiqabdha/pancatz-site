---
import Layout from '../layouts/Layout.astro';
import WorkCard from '../components/WorkCard.astro';
import CTA from '../components/CTA.astro';
import { work } from '../data/services';
---
<Layout title="Work" description="Selected design, print, IT, AI and photography projects by Pancatz, Kulai, Johor, Malaysia.">
  <section class="wrap" style="padding-top:calc(var(--header-h) + clamp(3rem,10vh,7rem));padding-bottom:clamp(2rem,5vw,4rem)">
    <p class="label" style="margin-bottom:1.5rem"><b>[ Work ]</b> {work.length} projects</p>
    <h1 class="display" data-split="hero">Selected<br/>work.</h1>
    <div class="filter" data-filter="#work-list" style="margin-top:clamp(2rem,4vw,3rem)" role="group" aria-label="Filter work">
      <button data-value="all" aria-pressed="true">All</button>
      <button data-value="design" aria-pressed="false">Design & Print</button>
      <button data-value="tech" aria-pressed="false">Tech, AI & Photo</button>
    </div>
  </section>
  <section class="wrap rule" style="padding-block:clamp(2rem,5vw,4rem) clamp(5rem,10vw,9rem)">
    <div id="work-list" class="work-grid work-grid--3">{work.map((w, i) => <WorkCard item={w} index={i} />)}</div>
  </section>
  <CTA title="Your project next" />
</Layout>
