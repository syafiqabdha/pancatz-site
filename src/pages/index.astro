---
import Layout from '../layouts/Layout.astro';
import SectionHead from '../components/SectionHead.astro';
import WorkCard from '../components/WorkCard.astro';
import CTA from '../components/CTA.astro';
import ShowreelPlayer from '../components/remotion/ShowreelPlayer';
import { site } from '../data/site';
import { sides, work, process } from '../data/services';

const marquee = ['Brand identity', 'Marketing', 'Print', 'Signage', 'IT support', 'Networks', 'Websites', 'AI chatbots', 'Automation', 'Photography', 'Social kits'];

const journey = [
  { side: 'design', title: 'Name, logo & identity', text: 'A brand that looks like it belongs on the main road, not in a template.' },
  { side: 'design', title: 'Menus, cards & signage', text: 'Designed and printed locally, ready for opening day.' },
  { side: 'tech', title: 'WiFi, devices & network', text: 'Counter, kitchen and guest WiFi set up, secured and documented.' },
  { side: 'tech', title: 'Website & Google', text: 'A fast site with your menu and hours, found when people search nearby.' },
  { side: 'tech', title: 'Orders on autopilot', text: 'A chatbot answers FAQs and routes orders while you cook.' },
  { side: 'tech', title: 'Photos that sell', text: 'Food and space photography for the menu, Grab listing and socials.' },
] as const;
---

<Layout>
  <!-- ── Hero ── -->
  <section class="hero-field" aria-labelledby="hero-title">
    <div class="hero-bg" data-hero-gl></div>
    <div class="hero-copy wrap">
      <p class="label hero-kicker" style="margin-bottom:clamp(1rem,3vh,2rem)">[ Studio ] Design · Print · Tech · AI · Photo — {site.location}</p>
      <h1 id="hero-title" class="hero-h1" data-split="hero">
        <span class="ln">Look <em>sharper.</em></span>
        <span class="ln">Run <strong>smarter.</strong></span>
      </h1>
    </div>
    <div class="hero-bar">
      <div class="wrap">
        <p class="lead" style="max-width:46ch;color:var(--ink)">One studio for the things customers <em class="voice-design">see</em> and the systems they <strong class="voice-tech">don’t</strong>. Brand and print, IT and AI, photos that sell.</p>
        <div style="display:flex;flex-wrap:wrap;gap:.6rem">
          <a href="/contact" class="btn" data-magnetic>Start a project <span class="arrow" aria-hidden="true">→</span></a>
          <a href="#sides" class="btn btn--ghost">What we do</a>
        </div>
        <span class="scroll-hint" aria-hidden="true"><i></i>Scroll</span>
      </div>
    </div>
  </section>

  <!-- ── Marquee ── -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[...marquee, ...marquee].map((m) => <span>{m}</span>)}
    </div>
  </div>

  <!-- ── Statement ── -->
  <section class="section wrap">
    <p class="label" style="margin-bottom:2rem"><b>[01]</b> Why one studio</p>
    <p class="statement" data-statement>
      Most businesses hire a designer, a printer, an IT guy and a developer, then spend months getting them to talk. At Pancatz it’s one team: we make you <em>look sharper</em> and <strong>run smarter</strong>, with one contact and one standard.
    </p>
  </section>

  <!-- ── Showreel: a live Remotion <Player>, source in src/remotion/showreel ── -->
  <section class="reel-section" aria-label="Showreel">
    <div class="wrap">
      <div class="reel" data-reel role="img" aria-label="Pancatz showreel: design, print, tech, AI and photography">
        <ShowreelPlayer client:only="react" whatsapp={site.whatsappDisplay} url={site.url.replace(/^https?:\/\//, '')}>
          <img slot="fallback" src="/video/poster.jpg" width="1280" height="720" alt="" loading="lazy" style="width:100%;height:auto" />
        </ShowreelPlayer>
      </div>
    </div>
  </section>

  <!-- ── Brand maker teaser: a plain GET form, so it works without JS ── -->
  <section class="section rule try-teaser" aria-labelledby="try-title">
    <div class="wrap">
      <p class="label" style="margin-bottom:1.5rem"><b>[ Try it ]</b> Free · 10 seconds · no sign-up</p>
      <h2 id="try-title" class="h2" data-split>See your shop<br/>as a <em>brand.</em></h2>
      <form class="try-line" action="/try" method="get">
        <label for="try-n">My shop is called</label>
        <input id="try-n" name="n" maxlength="24" placeholder="Kedai Ali" autocomplete="off" required />
        <button class="btn" type="submit" data-magnetic>Brand it <span class="arrow" aria-hidden="true">→</span></button>
      </form>
      <p class="muted" style="margin-top:1rem;max-width:52ch">We animate a logo, colours, signboard, card and post for it, right in your browser. Save the video and send it to a friend.</p>
    </div>
  </section>

  <!-- ── Two sides ── -->
  <section id="sides" class="section rule" style="padding-top:clamp(3rem,6vw,6rem)">
    <div class="wrap">
      <SectionHead index="02" label="Two sides, one studio" title="Pick a side.<br/>Or take both." lead="Move across the panel. Design & Print on the left, Tech, AI & Photography on the right. Click either to dive in." />
      <div class="stage" data-stage>
        <div class="stage-panel stage-panel--tech" data-side="tech">
          <p class="label" style="color:#fff">[B] {sides.tech.name}</p>
          <h2>Tech, AI<br />& <strong>Photo</strong></h2>
          <div style="display:grid;gap:1rem;justify-items:end">
            <div class="stage-chips">{sides.tech.disciplines.map((d) => <span class="chip">{d}</span>)}</div>
            <span class="stage-cta">Explore tech →</span>
          </div>
        </div>
        <div class="stage-panel stage-panel--design" data-side="design">
          <p class="label" style="color:var(--ink)">[A] {sides.design.name}</p>
          <h2>Design<br />& <em>Print</em></h2>
          <div style="display:grid;gap:1rem">
            <div class="stage-chips">{sides.design.disciplines.map((d) => <span class="chip">{d}</span>)}</div>
            <span class="stage-cta">Explore design →</span>
          </div>
        </div>
        <div class="stage-divider" aria-hidden="true"></div>
        <a class="stage-link stage-link--design" href={sides.design.href} aria-label="Explore Design & Print"></a>
        <a class="stage-link stage-link--tech" href={sides.tech.href} aria-label="Explore Tech, AI & Photography"></a>
      </div>
    </div>
  </section>

  <!-- ── Journey (horizontal) ── -->
  <section class="rule" data-journey>
    <div class="journey-pin" style="padding-block:clamp(4rem,8vw,6rem)">
      <div class="wrap" style="display:flex;justify-content:space-between;align-items:end;gap:2rem;flex-wrap:wrap;margin-bottom:clamp(2rem,4vw,3rem)">
        <div>
          <p class="label" style="margin-bottom:1rem"><b>[03]</b> Better together · an example</p>
          <h2 class="h2" data-split>Opening a café?<br />Here’s the whole project.</h2>
        </div>
        <p class="lead" style="max-width:32ch">Six things a new shop needs. Usually that’s five vendors. With us it’s one chat group.</p>
      </div>
      <div class="journey-track">
        {journey.map((j, i) => (
          <article class="journey-card" data-side={j.side} data-reveal>
            <div style="display:flex;justify-content:space-between;align-items:start">
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <span class="chip" style="color:var(--accent)">{j.side === 'design' ? 'Design & Print' : 'Tech & AI'}</span>
            </div>
            <div>
              <h3 style="margin-bottom:.75rem">{j.title}</h3>
              <p class="muted">{j.text}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="wrap journey-progress" style="margin-top:2rem">
        <div style="height:2px;background:var(--line)"><div data-journey-bar style="height:100%;background:var(--ink);transform-origin:left"></div></div>
      </div>
    </div>
  </section>

  <!-- ── Work ── -->
  <section class="section rule">
    <div class="wrap">
      <SectionHead index="04" label="Selected work" title="Proof,<br/>not promises." lead="A few recent projects across both sides of the studio. Full case studies are on the way.">
        <div><a href="/work" class="btn btn--ghost">All work <span class="arrow" aria-hidden="true">→</span></a></div>
      </SectionHead>
      <div class="work-grid work-grid--stagger">
        {work.slice(0, 4).map((w, i) => <WorkCard item={w} index={i} />)}
      </div>
    </div>
  </section>

  <!-- ── Process ── -->
  <section class="section rule">
    <div class="wrap">
      <SectionHead index="05" label="How it works" title="Three steps.<br/>No runaround." />
      {process.map((s) => (
        <div class="step">
          <span class="n">{s.n}</span>
          <h3 class="h3">{s.title}</h3>
          <p class="muted" style="max-width:40ch">{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <CTA />
</Layout>

<script>
  import { initHeroGL } from '../scripts/hero-gl';
  const el = document.querySelector<HTMLElement>('[data-hero-gl]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el) initHeroGL(el, { animate: !reduced });
</script>
