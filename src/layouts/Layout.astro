---
import '@fontsource-variable/mona-sans/wdth.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/doto/index.css';
import '@fontsource-variable/geist-mono/index.css';
import '../styles/global.css';
import { site, nav, whatsappLink } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  side?: 'design' | 'tech';
}

const { title, description = site.description, side } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | Design, Print, Tech & AI studio in Kulai, Johor`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/pancatz-logo.jpg" />
    <meta name="theme-color" content="#f2f0eb" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/pancatz_og.png', site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      name: site.name,
      url: site.url,
      email: site.email,
      telephone: `+${site.whatsapp}`,
      image: new URL('/pancatz-logo.jpg', site.url).href,
      address: { '@type': 'PostalAddress', addressLocality: 'Kulai', addressRegion: 'Johor', addressCountry: 'MY' },
      areaServed: ['Johor', 'Malaysia', 'Singapore'],
      sameAs: [site.instagramUrl, site.facebookUrl],
    })} />
  </head>
  <body data-side={side}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="grid-bg" aria-hidden="true">{Array.from({ length: 12 }, () => <span />)}</div>

    <header id="site-header" class="site-header">
      <div class="wrap">
        <a href="/" class="brand" aria-label="Pancatz home">
          <img src="/pancatz-logo.webp" alt="" width="34" height="34" />
          <span>Pancatz</span>
        </a>
        <nav class="nav" aria-label="Primary">
          {nav.map((n) => (
            <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>
              <span data-text={n.label}>{n.label}</span>
            </a>
          ))}
        </nav>
        <div style="display:flex;gap:.5rem;align-items:center">
          <a href="/contact" class="btn header-cta" style="min-height:44px;padding:.6rem 1.1rem">Start a project <span class="arrow" aria-hidden="true">→</span></a>
          <button id="menu-btn" class="menu-btn" aria-expanded="false" aria-controls="menu"><span>Menu</span></button>
        </div>
      </div>
    </header>

    <div id="menu" class="menu" role="dialog" aria-modal="true" aria-label="Menu">
      <nav aria-label="Mobile">
        <a href="/" data-menu-item>Home</a>
        {nav.map((n) => <a href={n.href} data-menu-item>{n.label}</a>)}
        <a href="/contact" data-menu-item>Contact</a>
      </nav>
      <div style="display:grid;gap:.75rem">
        <a class="btn btn--wa" href={whatsappLink()} target="_blank" rel="noopener">WhatsApp us <span class="arrow" aria-hidden="true">→</span></a>
        <p class="label" style="color:#9d9ca3">{site.location} · {site.email}</p>
      </div>
    </div>

    <main id="main">
      <slot />
    </main>

    <footer class="inverse" style="padding-top:clamp(4rem,8vw,7rem)">
      <div class="wrap">
        <div style="display:grid;gap:2.5rem;grid-template-columns:repeat(auto-fit,minmax(180px,1fr))">
          <div>
            <p class="label" style="margin-bottom:1rem">Studio</p>
            <p style="max-width:24ch">Design, print, tech, AI and photography under one roof in {site.location}.</p>
          </div>
          <div>
            <p class="label" style="margin-bottom:1rem">Explore</p>
            <ul style="list-style:none;margin:0;padding:0;display:grid;gap:.5rem">
              {nav.map((n) => <li><a class="link-u" href={n.href}>{n.label}</a></li>)}
              <li><a class="link-u" href="/contact">Contact</a></li>
            </ul>
          </div>
          <div>
            <p class="label" style="margin-bottom:1rem">Talk</p>
            <ul style="list-style:none;margin:0;padding:0;display:grid;gap:.5rem">
              <li><a class="link-u" href={whatsappLink()} target="_blank" rel="noopener">WhatsApp</a></li>
              <li><a class="link-u" href={`mailto:${site.email}`}>{site.email}</a></li>
            </ul>
          </div>
          <div>
            <p class="label" style="margin-bottom:1rem">Follow</p>
            <ul style="list-style:none;margin:0;padding:0;display:grid;gap:.5rem">
              <li><a class="link-u" href={site.instagramUrl} target="_blank" rel="noopener">Instagram</a></li>
              <li><a class="link-u" href={site.facebookUrl} target="_blank" rel="noopener">Facebook</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-mark" data-footer-mark aria-hidden="true" style="margin-top:clamp(3rem,8vw,6rem)">Pancatz</div>
        <div class="label" style="display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;padding-block:1.25rem;border-top:1px solid var(--line)">
          <span>© {new Date().getFullYear()} {site.name}</span>
          <span>{site.serviceArea}</span>
        </div>
      </div>
    </footer>

    <aside class="mascot" data-mascot hidden aria-label="Pan, the Pancatz mascot">
      <div class="mascot-bubble" data-mascot-bubble role="status" aria-live="polite"></div>
      <button type="button" class="mascot-poke" data-mascot-poke aria-label="Say hi to Pan">
        <span class="mascot-stage" data-mascot-stage><img class="mascot-still" src="/images/pancatz-mascot.webp" width="320" height="320" alt="" loading="lazy" /></span>
      </button>
      <button type="button" class="mascot-close" data-mascot-close aria-label="Hide Pan">×</button>
      <span class="mascot-z" aria-hidden="true"><i>z</i><i>z</i><i>z</i></span>
    </aside>
    <div class="grain" aria-hidden="true"></div>

    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
